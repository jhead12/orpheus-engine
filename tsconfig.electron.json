{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./electron/.tsbuildinfo", 
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["node"],
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["electron/**/*"],
  "exclude": ["src/**/*", "dist/**/*", "node_modules/**/*"]
}
