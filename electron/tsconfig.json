{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "../build/electron",
    "baseUrl": ".",
    "paths": {
      "*": ["../node_modules/*"],
      "../src/services/types/types": ["../workstation/frontend/OEW-main/src/services/types/types"],
      "../src/services/electron/channels": ["../workstation/frontend/OEW-main/src/services/electron/channels"]
    },
    "lib": ["ES2020", "DOM"],
    "typeRoots": [
      "../node_modules/@types"
    ]
  },
  "include": [
    "./**/*"
  ]
}