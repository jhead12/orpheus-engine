{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2020"],
    "target": "ES2020", // Explicitly set target to ES2020 (higher than ES2015)
    "esModuleInterop": true,

    /* Linting */
    "strict": true
  },
  "include": ["vite.config.ts"]
}
